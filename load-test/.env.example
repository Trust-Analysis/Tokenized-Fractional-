# Environment overrides for the load-test suite (optional)

# Backend base URL (Http + REST). Default: http://localhost:3001
API_BASE_URL=http://localhost:3001

# Backend WebSocket target (used by the baseline helper).
# Default is the literal target in artillery/websocket.yml: ws://localhost:3001/ws
# Override per-run: npm run test:websocket -- -t ws://<host>:<port>/ws
WS_BASE_URL=ws://localhost:3001/ws

# On-chain Soroban order-matching driver (live runs only)
# SOROBAN_CONTRACT_ID=
# SOROBAN_RPC_URL=https://soroban-testnet.stellar.org:443
# SOROBAN_TRADER_SECRET=
