input {
  beats {
    port => 5044
    ssl => true
    ssl_certificate_authorities => ["/etc/ssl/rwa/ca.crt"]
    ssl_certificate => "/etc/ssl/rwa/logstash.crt"
    ssl_key => "/etc/ssl/rwa/logstash.key"
    ssl_verify_mode => "force_peer"
    tls_min_version => 1.2
  }
}

filter {
  if [fileset][module] == "nginx" {
    grok {
      match => { "message" => "%{COMBINEDAPACHELOG}" }
    }
    date {
      match => [ "timestamp", "dd/MMM/yyyy:HH:mm:ss Z" ]
    }
  }
}

output {
  elasticsearch {
    hosts => ["http://elasticsearch:9200"]
    index => "rwa-logs-%{+YYYY.MM.dd}"
  }
}