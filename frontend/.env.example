# Your deployed Soroban contract ID
VITE_CONTRACT_ID=C...

# Stellar RPC URL (mainnet: https://soroban.stellar.org:443)
VITE_RPC_URL=https://soroban-testnet.stellar.org:443

# Stellar network passphrase (mainnet: "Public Global Stellar Network ; September 2015")
VITE_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# Backend metadata URL
VITE_API_URL=http://localhost:3001

# Signed canonical manifest of official contract addresses (Issue #792).
# The frontend cross-checks VITE_CONTRACT_ID against this at startup and warns
# if the address is missing or the manifest cannot be verified.
# See docs/contract-address-verification.md
# VITE_CONTRACT_MANIFEST_URL=/official-contracts.json
# Additional pinned signer public keys (base64, comma-separated) for key rotation.
# VITE_CONTRACT_MANIFEST_SIGNERS=

# Optional CDN base URL for production frontend build assets.
# Example: https://cdn.example.com
# VITE_CDN_URL=

# Sentry error tracking and performance monitoring (optional)
# VITE_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# VITE_SENTRY_TRACES_SAMPLE_RATE=0.1

# WalletConnect (Issue #568) — extended mobile/hardware wallet support.
# Get a project id from https://cloud.walletconnect.com/
# VITE_WALLETCONNECT_PROJECT_ID=your-project-id
# VITE_WALLETCONNECT_RELAY_URL=wss://relay.walletconnect.com
