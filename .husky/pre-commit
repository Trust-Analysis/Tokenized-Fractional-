#!/usr/bin/env sh
set -e

if command -v gitleaks >/dev/null 2>&1; then
  gitleaks git --staged --config .gitleaks.toml --redact
else
  echo "WARNING: gitleaks is not installed; skipping local pre-commit secret scan." >&2
  echo "Install it in one command via: ./scripts/setup.sh --gitleaks" >&2
  echo "CI still scans pushed commits/PRs, but if a secret is ever pushed, rotate it immediately even if CI blocks the PR." >&2
fi

if command -v npx >/dev/null 2>&1 && [ -f package.json ]; then
  npx --no-install lint-staged || true
fi
