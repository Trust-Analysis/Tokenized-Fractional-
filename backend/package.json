{
  "name": "rwa-marketplace-backend",
  "version": "2.0.0",
  "description": "Off-chain metadata API for RWA marketplace",
  "main": "src/server.js",
  "type": "module",
  "engines": {
    "node": ">=20.18.0"
  },
  "scripts": {
    "start": "node index.js",
    "dev": "node --watch index.js",
    "test": "node --experimental-vm-modules node_modules/.bin/jest --forceExit",
    "test:coverage": "node --experimental-vm-modules node_modules/.bin/jest --coverage --forceExit",
    "deploy": "echo 'Push to main — Render auto-deploys via render.yaml'",
    "migrate": "knex migrate:latest",
    "migrate:rollback": "knex migrate:rollback",
    "migrate:make": "knex migrate:make",
    "migrate:status": "knex migrate:list",
    "lint": "eslint . --ext .js",
    "lint:ci": "eslint . --ext .js --max-warnings=0",
    "lint:fix": "eslint . --ext .js --fix",
    "bootstrap-api-key": "node bootstrap-api-key.js",
    "backup": "node backup.js",
    "backup:list": "node backup.js --list",
    "backup:verify": "node backup.js --verify-latest",
    "restore": "node restore.js",
    "docs:generate": "node scripts/generate-docs.js",
    "docs:serve": "node scripts/generate-docs.js && echo \"Docs generated in docs/api/\""
  },
  "jest": {
    "testEnvironment": "node",
    "globalSetup": "./__tests__/setup.js",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "__tests__/setup.js"
    ],
    "transform": {},
    "collectCoverage": false,
    "collectCoverageFrom": [
      "src/**/*.js"
    ],
    "coveragePathIgnorePatterns": [
      "/node_modules/",
      "__tests__/"
    ],
    "coverageReporters": [
      "text",
      "lcov",
      "json-summary",
      "html"
    ],
    "coverageDirectory": "coverage",
    "coverageThreshold": {
      "global": {
        "lines": 80,
        "functions": 80,
        "branches": 80,
        "statements": 80
      }
    }
  },
  "dependencies": {
    "@apollo/gateway": "^2.7.0",
    "@apollo/server": "^4.10.1",
    "@apollo/subgraph": "^2.7.0",
    "@sentry/node": "^10.60.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.10.0",
    "cors": "^2.8.5",
    "dataloader": "^2.2.2",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "express-prom-bundle": "^7.0.0",
    "express-rate-limit": "^7.4.0",
    "form-data": "^4.0.6",
    "graphql": "^16.8.1",
    "graphql-tag": "^2.12.7",
    "graphql-ws": "^5.16.0",
    "handlebars": "^4.7.8",
    "helmet": "^7.1.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.0",
    "knex": "^3.1.0",
    "mjml": "^4.15.3",
    "multer": "^2.2.0",
    "nodemailer": "^6.9.13",
    "pg": "^8.14.1",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@jest/globals": "^30.4.1",
    "eslint": "^8.57.1",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.6",
    "jest": "^29.7.0",
    "jest-cli": "^29.7.0",
    "prettier": "^3.9.1"
  }
}
