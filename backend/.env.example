# ── Required ──────────────────────────────────────────────────────────────────

# Admin API key for write operations. REQUIRED and must be at least 16
# characters. Generate a strong random value, e.g. `openssl rand -hex 32`.
ADMIN_API_KEY=change-me-to-a-random-32-byte-secret

# Comma-separated list of origins allowed by CORS. Each entry must be a valid
# http(s) origin (or "*"). REQUIRED — there is no default fallback.
# Example for production: https://your-frontend.onrender.com
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# Path to the JSON asset data file, relative to the backend directory.
# REQUIRED — must end in ".json" and must not contain "..".
DATA_FILE=data.json

# ── Optional (safe defaults shown) ────────────────────────────────────────────

# Admin email for billing notifications
# ADMIN_EMAIL=admin@example.com

# Path to the JSON webhook store, relative to the backend directory.
# Must end in ".json" and must not contain "..". Defaults to webhooks.json.
# WEBHOOK_DATA_FILE=webhooks.json

# Runtime environment. Set to "production" in deployed environments.
# One of: development | test | production | staging. Defaults to development.
# NODE_ENV=development

# Database URL (used by Knex migrations)
# SQLite (development): leave as default or set a file path
# DATABASE_URL=./dev.db
# PostgreSQL (production):
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── Database Connection Pool (Production) ──────────────────────────────────
# Issue #314: Optimized connection pooling for high concurrency
# DATABASE_SSL=false
# DB_POOL_MIN=2
# DB_POOL_MAX=20
# DB_ACQUIRE_TIMEOUT=30000
# DB_CREATE_TIMEOUT=5000
# DB_DESTROY_TIMEOUT=5000
# DB_IDLE_TIMEOUT=60000
# DB_REAP_INTERVAL=1000
# DB_CREATE_RETRY_INTERVAL=100

# ── Redis cache (optional) ────────────────────────────────────────────────────
# When unset the backend falls back to an in-process no-op cache.
# Use rediss:// (note the double-s) as the URL scheme for TLS connections.
#
#   Plain TCP:    redis://localhost:6379
#   TLS:          rediss://localhost:6380
#
# REDIS_URL=redis://localhost:6379

# How long (seconds) cached API responses are kept. Must be a positive integer.
# CACHE_TTL_SECONDS=60

# CDN base URL used when API metadata stores relative image/document paths.
# ASSET_CDN_URL overrides CDN_URL for uploaded asset metadata.
# Example: https://assets-cdn.example.com
# CDN_URL=
# ASSET_CDN_URL=

# ── Content Security Policy (CSP) Configuration ────────────────────────────────
# Enable/disable CSP (default: true)
# CSP_ENABLED=true

# CSP report-only mode (default: false - set to true for testing)
# CSP_REPORT_ONLY=false

# URI for CSP violation reports
# CSP_REPORT_URI=/api/v1/security/csp-report

# Verified RPC providers allowed in connect-src (comma-separated)
# Defaults to Stellar mainnet and testnet RPC endpoints
# CSP_RPC_PROVIDERS=https://horizon.stellar.org,https://rpc.mainnet.stellar.org,https://rpc.testnet.stellar.org

# Additional image sources for img-src (comma-separated)
# CSP_IMG_SOURCES=

# Additional script sources for script-src (comma-separated)
# SCRIPT_SOURCES=

# Additional style sources for style-src (comma-separated)
# STYLE_SOURCES=

# Frame ancestors for frame-ancestors directive (comma-separated)
# FRAME_ANCESTORS='self'

# HSTS configuration
# HSTS_MAX_AGE=31536000
# HSTS_INCLUDE_SUBDOMAINS=true
# HSTS_PRELOAD=false

# ── GraphQL Playground Configuration ────────────────────────────────────────────
# Enable GraphQL Playground in production (default: false - only available in development)
# ENABLE_GRAPHQL_PLAYGROUND=false

# ── Structured logging (issue #703) ─────────────────────────────────────────────
# Every module logs through backend/logger.js as newline-delimited JSON on
# stdout, which is what the ELK pipeline in elk/ decodes. Do not use console.log
# in request paths and do not add a human-readable formatter in production.
# Minimum log level: trace | debug | info | warn | error | fatal | silent
# LOG_LEVEL=info
# Set LOG_PRETTY=false to force plain JSON even in development.
# LOG_PRETTY=true
# Docs: docs/OBSERVABILITY.md

# ── Error tracking / alerting (Sentry) ────────────────────────────────────────
# Opt-in. Without SENTRY_DSN the service only writes structured logs; the test
# suite never contacts Sentry. Credentials such as ADMIN_API_KEY are redacted
# from both log output and Sentry events.
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# SENTRY_ENVIRONMENT=production
# Release identifier shown in Sentry — use the deploy commit SHA.
# SENTRY_RELEASE=
# Performance monitoring sample rate, 0..1 (0 disables tracing).
# SENTRY_TRACES_SAMPLE_RATE=0.1
# Profiling sample rate, 0..1.
# SENTRY_PROFILES_SAMPLE_RATE=0.1

# ── Rate Limiting ──────────────────────────────────────────────────────────────
# Custom tier overrides (JSON). Defaults: free (100/min, burst 20), premium (1000/min, burst 200), enterprise (10000/min, burst 2000)
# RATE_LIMIT_TIERS={"free":{"maxRequests":200,"burstCapacity":30}}

# Rate limit analytics (default: true)
# RATE_LIMIT_ANALYTICS_ENABLED=true
# RATE_LIMIT_ANALYTICS_MAX_LOG=10000

# ── Anomaly Detection ──────────────────────────────────────────────────────────
# Enable ML-based anomaly detection (default: true)
# ANOMALY_DETECTION_ENABLED=true
# ANOMALY_BURST_THRESHOLD=50
# ANOMALY_TIME_WINDOW_MS=10000
# ANOMALY_CONFIDENCE_THRESHOLD=0.7

# ── Geographic Rate Limiting ───────────────────────────────────────────────────
# Enable geographic rate limiting (default: true)
# GEO_LIMITING_ENABLED=true
# Comma-separated list of blocked country codes (ISO 3166-1 alpha-2)
# GEO_BLOCKED_COUNTRIES=
# Comma-separated list of restricted countries with hourly limits (e.g. "US:500,GB:300")
# GEO_RESTRICTED_COUNTRIES=

# ── Billing Integration ────────────────────────────────────────────────────────
# Enable billing integration (default: true)
# BILLING_INTEGRATION_ENABLED=true
# Stripe secret key (optional — billing runs in usage-tracking mode without it)
# STRIPE_SECRET_KEY=
# Stripe price IDs per tier (optional)
# STRIPE_PRICE_FREE=
# STRIPE_PRICE_PREMIUM=
# STRIPE_PRICE_ENTERPRISE=
