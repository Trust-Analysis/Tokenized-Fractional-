# API Gateway Configuration Template
# Copy to .env and fill in your values

# ────────────────────────────────────────────────────────────────
# Gateway Selection
# ────────────────────────────────────────────────────────────────
GATEWAY_TYPE=kong  # Options: aws, kong, apigee

# ────────────────────────────────────────────────────────────────
# Environment
# ────────────────────────────────────────────────────────────────
ENVIRONMENT=production  # development, staging, production
NODE_ENV=production
LOG_LEVEL=info  # debug, info, warn, error

# ────────────────────────────────────────────────────────────────
# AWS Configuration
# ────────────────────────────────────────────────────────────────
AWS_REGION=us-east-1
AWS_PROFILE=default
CDK_DEFAULT_REGION=us-east-1
CDK_DEFAULT_ACCOUNT=123456789012  # Replace with your AWS account ID

# ────────────────────────────────────────────────────────────────
# Kong Configuration
# ────────────────────────────────────────────────────────────────
KONG_DATABASE=postgres
KONG_PG_HOST=kong-database
KONG_PG_USER=kong
KONG_PG_PASSWORD=kong  # Change in production
KONG_PROXY_LISTEN=0.0.0.0:8000
KONG_ADMIN_LISTEN=0.0.0.0:8001
KONG_ADMIN_GUI_LISTEN=0.0.0.0:8002

# ────────────────────────────────────────────────────────────────
# Apigee Configuration
# ────────────────────────────────────────────────────────────────
APIGEE_ORGANIZATION=your-org
APIGEE_ENVIRONMENT=prod
APIGEE_USERNAME=admin@example.com
APIGEE_PASSWORD=your-password  # Use environment variable in production

# ────────────────────────────────────────────────────────────────
# Backend Service Configuration
# ────────────────────────────────────────────────────────────────
BACKEND_URL=http://localhost:3001
BACKEND_TIMEOUT=30000  # milliseconds
BACKEND_RETRIES=3

# ────────────────────────────────────────────────────────────────
# Authentication
# ────────────────────────────────────────────────────────────────
JWT_SECRET=dev-secret-change-in-production  # Use strong secret in production
JWT_ALGORITHM=HS256
JWT_EXPIRATION=1h
API_KEY_LENGTH=32  # Minimum API key length
API_KEY_FORMAT=^[a-zA-Z0-9\-_]{32,}$  # API key regex pattern

# ────────────────────────────────────────────────────────────────
# OAuth 2.0 (if using)
# ────────────────────────────────────────────────────────────────
OAUTH_CLIENT_ID=your-client-id
OAUTH_CLIENT_SECRET=your-client-secret  # Use environment variable in production
OAUTH_TOKEN_ENDPOINT=https://auth.example.com/token
OAUTH_AUTHORIZE_ENDPOINT=https://auth.example.com/authorize

# ────────────────────────────────────────────────────────────────
# Rate Limiting
# ────────────────────────────────────────────────────────────────
RATE_LIMIT_ALGORITHM=sliding-window  # sliding-window, token-bucket
RATE_LIMIT_WINDOW=3600  # seconds (1 hour)
RATE_LIMIT_MAX_REQUESTS=1000  # per window
RATE_LIMIT_BURST_SIZE=100  # max burst requests

# Per-tier rate limits
RATE_LIMIT_FREE_REQUESTS=100
RATE_LIMIT_BASIC_REQUESTS=1000
RATE_LIMIT_PROFESSIONAL_REQUESTS=10000
RATE_LIMIT_ENTERPRISE_REQUESTS=100000

# ────────────────────────────────────────────────────────────────
# Monitoring and Logging
# ────────────────────────────────────────────────────────────────
MONITORING_ENABLED=true
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090
CLOUDWATCH_ENABLED=false  # Enable for AWS deployments
DATADOG_ENABLED=false
DATADOG_API_KEY=your-datadog-api-key

# ────────────────────────────────────────────────────────────────
# Security
# ────────────────────────────────────────────────────────────────
ENABLE_CORS=true
CORS_ORIGINS=*  # Restrict in production: https://example.com
CORS_CREDENTIALS=true
CORS_MAX_AGE=3600

ENABLE_RATE_LIMIT=true
ENABLE_WAF=true  # AWS only

# ────────────────────────────────────────────────────────────────
# Request/Response Transformation
# ────────────────────────────────────────────────────────────────
REQUEST_VALIDATION_ENABLED=true
RESPONSE_TRANSFORMATION_ENABLED=true
REQUEST_SIZE_LIMIT=10kb
BODY_PARSER_LIMIT=10kb

# Sensitive fields to redact
REDACT_FIELDS=password,apiKey,secret,token,ssn,creditCard

# ────────────────────────────────────────────────────────────────
# Admin Configuration
# ────────────────────────────────────────────────────────────────
ADMIN_API_KEY=dev-admin-key-change-in-production
ADMIN_API_KEY_LENGTH=32

# ────────────────────────────────────────────────────────────────
# Health Check Configuration
# ────────────────────────────────────────────────────────────────
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_INTERVAL=30000  # milliseconds
HEALTH_CHECK_TIMEOUT=5000

# ────────────────────────────────────────────────────────────────
# Sentry (Error Tracking)
# ────────────────────────────────────────────────────────────────
SENTRY_DSN=https://key@sentry.io/project-id
SENTRY_ENABLED=false
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.1

# ────────────────────────────────────────────────────────────────
# Cache Configuration (for API responses)
# ────────────────────────────────────────────────────────────────
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379
CACHE_TTL=300  # seconds

# ────────────────────────────────────────────────────────────────
# CDN Configuration (for static assets)
# ────────────────────────────────────────────────────────────────
CDN_ENABLED=false
CDN_URL=https://cdn.example.com
CDN_CACHE_CONTROL=public, max-age=31536000
